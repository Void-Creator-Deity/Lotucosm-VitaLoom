{
  "name": "战争后进化（三幕演示）",
  "version": "1.0",
  "sr_demo_legend": {
    "title": "战争后进化 · 图例",
    "lines": [
      "▶ 运行后三幕：0–50s 和平繁殖 · 50–85s 战争 · 85s+ 灾后恢复",
      "开局 3 个分化细胞（游行者/保守者/膜趋化型）；按 W 可提前发动战争",
      "中央场域锚脉冲变强时表示战争窗；HUD 可看 war_phase",
      "细胞靠膜趋化觅食、PVAEC 内稳态与突变繁殖在灾后重建种群",
      "金色微粒：营养 · 淡蓝大圆：场域锚 / 战争导演"
    ]
  },
  "pond_config": {
    "name": "PVAEC · 战争后进化莲池",
    "size": [
      920,
      620
    ],
    "initial_components": 20,
    "initial_organisms": 3,
    "sr_physics2d": {
