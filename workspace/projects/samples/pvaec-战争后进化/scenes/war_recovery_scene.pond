  "sr_play_goals": {
    "survive_seconds": 180,
    "peak_population": 10,
    "pause_on_complete": false,
    "hint_zh": "先和平繁殖（约 50s）；战争期代谢升高、营养稀缺；85s 后恢复期营养增加。按 W 可提前发动战争。",
    "hint_en": "Breed in peace (~50s); war hits metabolism and food; after 85s watch survivors evolve back.",
    "victory_title_zh": "灾后恢复 · 达标",
    "victory_title_en": "Post-War Recovery · Goals Met",
    "victory_banner_zh": "战争后仍达成存活与繁殖目标——演化继续。",
    "victory_banner_en": "Survival and breeding goals met after the war — evolution continues.",
    "extinction_title_zh": "种群灭绝",
    "extinction_title_en": "Extinction",
    "extinction_banner_zh": "战争或饥荒消灭了全部细胞，可调低 war_shock_drain 后重试。",
    "extinction_banner_en": "All cells lost — lower war_shock_drain and try again."
  },
