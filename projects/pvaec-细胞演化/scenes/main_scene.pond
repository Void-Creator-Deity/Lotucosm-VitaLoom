{
  "name": "主场景（细胞演化演示）",
  "version": "1.0",
  "sr_demo_legend": {
    "title": "莲池图例",
    "lines": [
      "顶部工具栏 ▶ 运行 / ⏹ 停止 · 此处调节倍速",
      "半透明圆泡：整细胞（细胞质 + 磷脂双分子层质膜）",
      "中央浅蓝核：控制中心 / 演化中枢（PVAEC 宿主）",
      "膜上绿球头：跨膜化学受体 · 橙色鞭毛束：纤毛效应器",
      "细胞之间、与营养/场域锚有圆体碰撞与反弹（非穿模高斯团）",
      "质膜形变由胞外营养/场域水流 + 胞内趋化能量流 + 游动压差驱动（非纯随机 sin）",
      "膜外蓝微粒：胞外水流 · 膜内绿微粒：胞内能量流 · 受体/纤毛：跨膜交换",
      "核旁弧线 + 光点：胞内趋化信号传导（sensor→actuator）",
      "金色微粒：营养 · 蓝色波纹：场域锚"
    ]
  },
