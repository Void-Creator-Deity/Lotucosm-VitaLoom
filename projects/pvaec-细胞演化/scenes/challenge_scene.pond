{
  "name": "挑战场景（高难度细胞演化）",
  "version": "1.0",
  "sr_demo_legend": {
    "title": "图例（挑战模式）",
    "lines": [
      "规则与主场景相同；代谢更高、营养更少、演示目标更严（180s / 峰值≥8）",
      "浅蓝大圆：细胞控制中心（带演化中枢脚本，趋近黄绿色营养颗粒并吞噬）",
      "绿色小圆：膜受体（化学感受，固定在膜上示意）",
      "橙色小圆：纤毛效应器（弱脉冲，示意划水）",
      "黄绿小圆：营养颗粒（食物，重叠即被吞噬移除；本场景仅 4 颗常驻）",
      "淡蓝大圆：场域锚（呼吸式发光，靠近可获额外代谢增益）",
      "淡青点线：场域锚与最近细胞在增益距离内的弱视觉提示（非拓扑连线）",
      "连线：控制中心与膜上组件的拓扑关系（非真实几何膜）"
    ]
  },
  "pond_config": {
    "name": "PVAEC · 细胞演化莲池·挑战",
